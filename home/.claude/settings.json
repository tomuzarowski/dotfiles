{
  "autoContinueAtUsageLimit": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "feedbackDrafts": "off",
  "language": "Polish",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark"
}
