theme = Atom One Dark
foreground = #c8ccd4
palette = 7=#c8ccd4
palette = 15=#d7dae0
font-family = Cascadia Code NF
font-size = 20
window-height = 30
window-width = 160
window-padding-x = 8
window-padding-y = 2
adjust-cell-height=35%
adjust-cursor-thickness = 2
cursor-style = block
cursor-style-blink = false
